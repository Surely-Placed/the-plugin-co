# Site
VITE_SITE_URL=https://theplugin.world
SITE_URL=https://theplugin.world

# Contact form API (frontend — use /api/contact on same domain in production)
VITE_CONTACT_API_URL=/api/contact
CONTACT_API_PORT=8787

# SMTP — Google Workspace / Gmail (use App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=grow@theplugin.world
SMTP_APP_PASSWORD=
CONTACT_TO_EMAIL=grow@theplugin.world
CONTACT_FROM_EMAIL=grow@theplugin.world

# Booking (Google Calendar appointment schedule)
VITE_CALENDLY_30_URL=https://calendar.app.google/SRL2hqvrR6G3TvJCA
VITE_CALENDLY_60_URL=https://calendar.app.google/SRL2hqvrR6G3TvJCA

# HubSpot CRM (optional — contact form uses SMTP by default)
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=

# Custom lead API (legacy — not needed when SMTP is configured)
VITE_LEAD_API_URL=

# Payments API (Fly.io backend) — Razorpay Key ID is returned by the backend,
# so it never needs to be set in the frontend.
VITE_PAYMENTS_API_URL=http://localhost:8080

# Vercel proxy target for /api/webhook/razorpay (production only)
PAYMENTS_API_URL=https://the-plugin-payments.fly.dev

# Analytics
VITE_GTM_ID=
VITE_GA4_ID=
VITE_CLARITY_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
